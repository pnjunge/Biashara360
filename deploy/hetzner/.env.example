# Public hostnames. Create A records for both before starting Caddy.
WEB_DOMAIN=app.biashara360.co.ke
API_DOMAIN=api.biashara360.co.ke
TLS_EMAIL=operations@example.com

# PostgreSQL (generate passwords with: openssl rand -base64 36)
POSTGRES_DB=biashara360
POSTGRES_USER=biashara360
POSTGRES_PASSWORD=replace_with_a_long_random_password

# Preserve these values from AWS so existing sessions and encrypted tokens survive.
JWT_SECRET=replace_with_the_current_aws_value
SOCIAL_TOKEN_ENCRYPTION_KEY=replace_with_the_current_aws_value
SUPERUSER_PASSWORD=replace_with_the_current_aws_value

# Payment providers
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORT_CODE=
MPESA_PASSKEYS_JSON=
MPESA_INITIATOR_NAME=
MPESA_INITIATOR_PASSWORD=
MPESA_CERTIFICATE_BASE64=
MPESA_RESULT_URL=
MPESA_TIMEOUT_URL=
MPESA_ACCOUNT_TYPE=
MPESA_ENV=production
CS_MERCHANT_ID=
CS_ORG_UNIT_ID=
CS_API_KEY=
CS_SHARED_SECRET=
CS_ENVIRONMENT=production

# Meta/social integrations
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_BUSINESS_LOGIN_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v25.0
META_SYSTEM_USER_TOKEN=

# Optional integrations
REDIS_URL=
ANTHROPIC_API_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_APIKEY=
AFRICASTALKING_ENVIRONMENT=production
AFRICASTALKING_SENDERID=
WHATSAPP_OTP_TOKEN=
WHATSAPP_OTP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_OTP_TEMPLATE_LANGUAGE=

# Optional frontend download links
VITE_ANDROID_DOWNLOAD_URL=
VITE_IOS_DOWNLOAD_URL=
VITE_WINDOWS_DOWNLOAD_URL=
VITE_LINUX_DOWNLOAD_URL=
VITE_MACOS_DOWNLOAD_URL=

# Optional off-site restic repository used by backup.sh.
# Example: s3:https://s3.eu-central-003.backblazeb2.com/bucket-name
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
