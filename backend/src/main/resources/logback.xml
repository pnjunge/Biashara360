<configuration>
    <!-- Console-only output is intentional: ECS/CloudWatch and Docker collect stdout. -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level request_id=%X{requestId:-none} logger=%logger{36} %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="org.jetbrains.exposed" level="WARN" />
    <logger name="com.zaxxer.hikari" level="INFO" />
    <logger name="org.flywaydb" level="INFO" />
    <logger name="io.netty" level="WARN" />
    <logger name="io.ktor" level="INFO" />

    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>
</configuration>
