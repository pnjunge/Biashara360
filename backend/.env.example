# ═══════════════════════════════════════════════════════════════════════════
# Biashara360 Backend Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to version control!

# ───────────────────────────────────────────────────────────────────────────
# Application Settings
# ───────────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
# Options: development, staging, production

PORT=8080
# Port the application will run on

# ───────────────────────────────────────────────────────────────────────────
# Database Configuration
# ───────────────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=biashara360
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_DRIVER=org.postgresql.Driver
DB_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}

# Connection Pool Settings
DB_MAX_POOL_SIZE=20
DB_CONNECTION_TIMEOUT=30000

# ───────────────────────────────────────────────────────────────────────────
# JWT Configuration
# ───────────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_at_least_256_bits_long_change_this_in_production
# Generate strong secret: openssl rand -base64 64

JWT_ISSUER=biashara360
JWT_AUDIENCE=biashara360-api
JWT_REALM=Biashara360 API

# Token Validity (in seconds)
JWT_ACCESS_TOKEN_VALIDITY=86400
# 86400 seconds = 24 hours

JWT_REFRESH_TOKEN_VALIDITY=2592000
# 2592000 seconds = 30 days

# ───────────────────────────────────────────────────────────────────────────
# M-Pesa Daraja API Configuration
# ───────────────────────────────────────────────────────────────────────────
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_SHORT_CODE=174379
# Your business shortcode (Paybill or Till number)

MPESA_PASS_KEY=your_mpesa_lipa_na_mpesa_online_passkey
# Get this from Daraja portal

MPESA_CALLBACK_URL=https://your-domain.com/v1/mpesa/callback
# Public URL where Safaricom will send payment notifications

MPESA_ENVIRONMENT=sandbox
# Options: sandbox, production

MPESA_ACCOUNT_TYPE=paybill
# Options: paybill, till

# ───────────────────────────────────────────────────────────────────────────
# CyberSource Payment Gateway Configuration
# ───────────────────────────────────────────────────────────────────────────
CYBERSOURCE_MERCHANT_ID=your_merchant_id
CYBERSOURCE_MERCHANT_KEY_ID=your_merchant_key_id
CYBERSOURCE_MERCHANT_SECRET_KEY=your_merchant_secret_key

CYBERSOURCE_ENVIRONMENT=sandbox
# Options: sandbox, production

CYBERSOURCE_RUN_ENVIRONMENT=apitest.cybersource.com
# sandbox: apitest.cybersource.com
# production: api.cybersource.com

# ───────────────────────────────────────────────────────────────────────────
# KRA eTIMS Integration
# ───────────────────────────────────────────────────────────────────────────
KRA_ETIMS_BASE_URL=https://etims-api.kra.go.ke
# Test: https://etims-sbx.kra.go.ke
# Production: https://etims-api.kra.go.ke

KRA_ETIMS_TIMEOUT=30000
# Timeout in milliseconds

# ───────────────────────────────────────────────────────────────────────────
# SMS Service (Africa's Talking)
# ───────────────────────────────────────────────────────────────────────────
AT_USERNAME=sandbox
# Your Africa's Talking username

AT_API_KEY=your_africas_talking_api_key
# Get from https://account.africastalking.com

AT_SENDER_ID=Biashara360
# Approved sender ID for your messages

AT_ENVIRONMENT=sandbox
# Options: sandbox, production

# ───────────────────────────────────────────────────────────────────────────
# Email Service (SendGrid / SMTP)
# ───────────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=your_sendgrid_api_key
SMTP_FROM_EMAIL=noreply@biashara360.com
SMTP_FROM_NAME=Biashara360

# Alternative: Use SendGrid API directly
SENDGRID_API_KEY=your_sendgrid_api_key

# ───────────────────────────────────────────────────────────────────────────
# Claude AI (for Social Commerce)
# ───────────────────────────────────────────────────────────────────────────
CLAUDE_API_KEY=your_anthropic_api_key
# Get from https://console.anthropic.com

CLAUDE_MODEL=claude-3-5-sonnet-20241022
# Options: claude-3-5-sonnet-20241022, claude-3-opus-20240229, etc.

# ───────────────────────────────────────────────────────────────────────────
# Social Platform Webhooks
# ───────────────────────────────────────────────────────────────────────────
# WhatsApp Business API
WHATSAPP_VERIFY_TOKEN=your_whatsapp_webhook_verify_token
WHATSAPP_ACCESS_TOKEN=your_whatsapp_business_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# Instagram / Facebook
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_PAGE_ACCESS_TOKEN=your_page_access_token

# ───────────────────────────────────────────────────────────────────────────
# CORS Configuration
# ───────────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-domain.com
# Comma-separated list of allowed origins

# ───────────────────────────────────────────────────────────────────────────
# Rate Limiting
# ───────────────────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_AUTH_REQUESTS_PER_MINUTE=10

# ───────────────────────────────────────────────────────────────────────────
# File Upload Configuration
# ───────────────────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads
# Directory for file uploads (relative or absolute path)

# AWS S3 (Optional - for production file storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=biashara360-uploads
AWS_S3_REGION=us-east-1

# ───────────────────────────────────────────────────────────────────────────
# Logging Configuration
# ───────────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Options: TRACE, DEBUG, INFO, WARN, ERROR

LOG_FILE_PATH=./logs/biashara360.log
# Path for log files

# ───────────────────────────────────────────────────────────────────────────
# Security
# ───────────────────────────────────────────────────────────────────────────
# Encryption key for sensitive data (generate with: openssl rand -base64 32)
ENCRYPTION_KEY=your_encryption_key_for_sensitive_data

# Session secret
SESSION_SECRET=your_session_secret_key

# ───────────────────────────────────────────────────────────────────────────
# Monitoring & Analytics (Optional)
# ───────────────────────────────────────────────────────────────────────────
SENTRY_DSN=your_sentry_dsn
# For error tracking: https://sentry.io

# Google Analytics
GA_TRACKING_ID=UA-XXXXXXXXX-X

# ───────────────────────────────────────────────────────────────────────────
# Feature Flags
# ───────────────────────────────────────────────────────────────────────────
ENABLE_OTP_2FA=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=true
ENABLE_KRA_INTEGRATION=true
ENABLE_SOCIAL_COMMERCE=true

# ───────────────────────────────────────────────────────────────────────────
# Super Admin Setup
# ───────────────────────────────────────────────────────────────────────────
SUPER_ADMIN_EMAIL=admin@biashara360.com
SUPER_ADMIN_PASSWORD=change_this_strong_password_immediately
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_PHONE=+254700000000

# ═══════════════════════════════════════════════════════════════════════════
# NOTES:
# ═══════════════════════════════════════════════════════════════════════════
# 1. Generate strong secrets using: openssl rand -base64 64
# 2. NEVER commit .env file to Git - keep it in .gitignore
# 3. Use different values for development, staging, and production
# 4. Rotate secrets regularly, especially JWT_SECRET
# 5. In production, use environment variables or secret management service
#    instead of .env file for enhanced security
# ═══════════════════════════════════════════════════════════════════════════
